[sqlfluff]
dialect = databricks
templater = dbt
sql_file_exts = .sql
max_line_length = 120
# ST06 (ordem de colunas apos wildcard) e RF02 (referencia nao qualificada em
# subquery de filtro incremental, ex: "select max(dt_ultima_ingestao) from {{ this }}")
# sao excluidas porque disparam falso positivo no filtro incremental de
# fct_pedido_venda, que usa exatamente esse padrao.
exclude_rules = ST06, RF02

[sqlfluff:templater:dbt]
profiles_dir = .
project_dir = .

[sqlfluff:indentation]
tab_space_size = 4

[sqlfluff:layout:type:comma]
line_position = leading
