# Copie este arquivo para ".env" (ja esta no .gitignore) e preencha com os dados
# do seu SQL Warehouse no Databricks Free Edition:
# - DBT_DATABRICKS_HOST: Server Hostname (aba Advanced Options > JDBC/ODBC do cluster)
# - DBT_DATABRICKS_HTTP_PATH: HTTP Path (mesma aba)
# - DBT_DATABRICKS_TOKEN: Personal Access Token (User Settings > Developer > Access tokens)

DBT_DATABRICKS_HOST=
DBT_DATABRICKS_HTTP_PATH=
DBT_DATABRICKS_TOKEN=
DBT_DEV_SCHEMA=dev_pedro
